# Docker Compose HTTPS deployment. Copy to .env and replace every value.
DOMAIN=salon.example.com
ACME_EMAIL=admin@example.com
# Generate a unique random token: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Minimum 24 characters. Never commit .env or reuse a login password here.
BOOTSTRAP_TOKEN=

# These values are used when starting Node directly with --env-file=.env.
# Docker Compose overrides them using DOMAIN and its internal container paths.
NODE_ENV=production
APP_ORIGIN=https://salon.example.com
HOST=127.0.0.1
PORT=3001
DB_PATH=./data/salon.sqlite
